{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist/client",
  "crons": [{ "path": "/api/cron/cleanup", "schedule": "0 3 * * *" }],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/s/(.*)", "destination": "/index.html" }
  ]
}
