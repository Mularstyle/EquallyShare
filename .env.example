# Local API port. Vite serves the UI on http://localhost:3000 and proxies /api to this port.
PORT=3001
PUBLIC_ORIGIN=http://localhost:3000
# Browser clients serialize first-time POST /api/session across tabs with Web Locks.
# PUBLIC_ORIGIN must match the browser-visible origin used for share URLs and QR codes.
# Local dev only: embedded PGlite database and source images live here, outside the Vite project root.
DATA_DIR=../equallyshare-private-data

# Production (Vercel env vars). Leave empty locally to use PGlite + local disk.
# Supabase Postgres via the transaction pooler (port 6543).
DATABASE_URL=
SUPABASE_URL=
# Server-only secret: never expose to the browser or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=share-originals
# Vercel Cron bearer token for /api/cron/cleanup (any long random string).
CRON_SECRET=
# Browser Realtime (public values, baked into the UI at build time).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

SESSION_TTL_HOURS=168
SHARE_TTL_HOURS=24
MAX_TEXT_GRAPHEMES=20000
MAX_RECIPIENTS=64
# Vercel Functions reject request bodies above 4.5 MB.
MAX_UPLOAD_BYTES=4194304
# Video and PDF upload straight to storage, so they can be larger.
MAX_DIRECT_UPLOAD_BYTES=52428800
MAX_IMAGE_PIXELS=12000000
MAX_IMAGE_EDGE=1024
MAX_CONCURRENT_RENDERS=4
JSON_BODY_LIMIT=262144
