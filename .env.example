PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
# Browser clients serialize first-time POST /api/session across tabs with Web Locks.
# PUBLIC_ORIGIN must match the browser-visible origin used for share URLs and QR codes.
# Keep source images outside the Vite project root.
DATA_DIR=../equallyshare-private-data
SESSION_TTL_HOURS=168
SHARE_TTL_HOURS=24
MAX_TEXT_GRAPHEMES=20000
MAX_RECIPIENTS=64
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=12000000
MAX_IMAGE_EDGE=1024
MAX_CONCURRENT_RENDERS=4
JSON_BODY_LIMIT=262144
